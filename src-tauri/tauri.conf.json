{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustLegal Desktop",
  "version": "0.1.0",
  "identifier": "me.justlegal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "JustLegal Desktop",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 Joshua Abrams / Just Liberty Inc.",
    "category": "Productivity",
    "shortDescription": "JustLegal OS — Private, local-first legal document formatting and court assembly desktop client."
  }
}