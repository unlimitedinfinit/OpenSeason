# Copy this file to `.env` (gitignored) if you want a local or release build
# to bake the Firebase Web API key in via option_env!.
#
# Get the Web API key from Firebase Console > Project settings > Your apps.
# Do not commit real keys. Rotate any key that was previously in git history.
#
# Runtime alternatives (checked first; no rebuild needed):
#   1. Environment variable OPENSEASON_FIREBASE_API_KEY
#   2. User config file outside the repo:
#        Windows: %LOCALAPPDATA%\JustLegal\config.json
#        macOS:   ~/Library/Application Support/JustLegal/config.json
#        Linux:   ~/.local/share/JustLegal/config.json
#      { "firebase_api_key": "your-web-api-key" }
#
# If this value is unset, cloud sync is disabled with a clear message.
# Offline drafting, checks, and export keep working.

OPENSEASON_FIREBASE_API_KEY=
